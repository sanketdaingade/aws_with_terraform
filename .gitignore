# ==========================================
# Official Terraform .gitignore Template
# ==========================================

# Local .terraform directories (contains downloaded providers and modules)
**/.terraform/*

# .tfstate files (contains sensitive system data and architecture mappings)
# Note: State should be stored securely in a remote backend, never in Git.
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all variable files containing credentials or environment-specific data
*.tfvars
*.tfvars.json

# Ignore override files used for local testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Ignore plan outputs (can contain secrets and shouldn't be version controlled)
*tfplan*
